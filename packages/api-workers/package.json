    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261003.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
