{
  "name": "@gbbo/api-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create gbbo-db",
